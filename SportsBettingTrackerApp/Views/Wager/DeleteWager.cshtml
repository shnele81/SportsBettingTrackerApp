@model SportsBettingTrackerApp.Models.WagerModel

@{
    ViewData["Title"] = "Delete Wager";
}

<p> Sport: @Model.WagerSport</p>
<p> Date: @Model.WagerDate</p>
<p> Type: @Model.WagerType</p>
<p> Amount Bet: @Model.WagerAmount</p>
<p> Result: @Model.WagerResult</p>
<p> Profit/Loss: @Model.AmountReturned</p>

<form asp-action="DeleteWager" method="post">
    <button type="submit" class="btn btn-primary">Delete Wager</button>
    <input type="hidden" asp-for="WagerId" />
</form>

<a asp-action="Index" class="btn btn-secondary">Cancel</a>